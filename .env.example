# ---------- PostgreSQL (Docker) ----------
# 15432 avoids local PostgreSQL (5432/5433) and Windows reserved port ranges
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=cla_db
POSTGRES_USER=cla_user
POSTGRES_PASSWORD=change_me

# ---------- Kafka ----------
# From your machine (scripts, services run locally)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- Elasticsearch ----------
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200